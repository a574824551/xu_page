[Unit]
Description=Personal website for xujinghui.com.cn
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
RuntimeDirectory=personal-site
LogsDirectory=nginx
CacheDirectory=personal-site
ExecStartPre=/opt/personal-site/nginx -t -c /etc/personal-site/nginx.conf
ExecStart=/opt/personal-site/nginx -c /etc/personal-site/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
